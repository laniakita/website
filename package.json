{
	"name": "@lani/website",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"turbo": "^2.11.3"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@react-three/a11y@3.0.0": "patches/@react-three%2Fa11y@3.0.0.patch",
		"@storybook/addon-mcp@10.6.0": "patches/@storybook%2Faddon-mcp@10.6.0.patch",
		"@storybook/tanstack-react@10.6.0": "patches/@storybook%2Ftanstack-react@10.6.0.patch",
		"@storybook/addon-vitest@10.6.0": "patches/@storybook%2Faddon-vitest@10.6.0.patch"
	},
	"private": true,
	"scripts": {
		"build:prebuild": "turbo run build:prebuild",
		"build": "turbo run build",
		"preview": "turbo run preview",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"deploy": "turbo run deploy",
		"deploy:production": "turbo run deploy:production",
		"typecheck": "turbo run typecheck",
		"format": "biome format",
		"cf-typegen": "turbo run cf-typegen",
		"generate-routes": "turbo run generate-routes",
		"storybook": "turbo run storybook",
		"build-storybook": "turbo run build-storybook",
		"pulumi:up": "turbo run pulumi:up",
		"pulumi:destroy": "turbo run pulumi:destroy",
		"pulumi:preview": "turbo run pulumi:preview",
		"pulumi:refresh": "turbo run pulumi:refresh",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:check": "turbo run db:check",
		"db:up": "turbo run db:up",
		"db:studio": "turbo run db:studio",
		"clean": "turbo run clean && rm -rf node_modules && bun pm cache rm && bun i"
	},
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/bun": "1.4.2",
			"@turbo/gen": "^2.9.15",
			"@types/node": "^26.2.0",
			"typescript": "^7.0.2",
			"wrangler": "^4.122.0"
		}
	}
}
