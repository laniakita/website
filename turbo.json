{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "CLOUDFLARE_API_TOKEN"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN"
      ]
    },
    "preview": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "check": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "cf-typegen": {},
    "generate-routes": {},
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {},
    "deploy": {
      "env": [
        "CLOUDFLARE_API_TOKEN"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN"
      ],
    },
    "deploy:preview": {
      "env": [
        "CLOUDFLARE_API_TOKEN"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN"
      ],
    },
    "clean": {
      "cache": false
    }
  }
}