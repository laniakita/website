{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "cf-typegen": {
      "outputs": ["worker-configuration.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "wrangler.toml",
        "wrangler.json",
        "wrangler.jsonc",
        ".dev.vars"
      ]
    },
    "deploy": {
      "dependsOn": ["cf-typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "src/**",
        "wrangler.toml",
        "wrangler.json",
        "wrangler.jsonc"
      ]
    }
  }
}
