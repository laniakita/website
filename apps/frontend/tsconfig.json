{
  "extends": "@lani/typescript-config/base.json",
  "include": ["**/*.ts", "**/*.tsx", ".source/*.ts"],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "paths": {
      "$/*": ["./*"],
      "@/*": ["./src/*"]
    },
    "types": [
      "./worker-configuration.d.ts",
      "node",
      "vite/client",
      "bun",
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
