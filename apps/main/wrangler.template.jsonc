/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "laniakita-frontend",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "LANI_DB",
			"database_name": "{{STAGING_DATABASE_NAME}}",
			"database_id": "{{STAGING_DATABASE_ID}}",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"r2_buckets": [
		{
			"binding": "LANI_BUCKET_PUBLIC",
			"bucket_name": "{{STAGING_BUCKET_PUBLIC_NAME}}"
		}
	],
	"kv_namespaces": [
		{
			"binding": "LANI_CACHE_KV",
			"id": "{{STAGING_CACHE_KV_ID}}"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER_GLOBAL",
			"namespace_id": "1001",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_OG",
			"namespace_id": "1001",
			"simple": {
				"limit": 24,
				"period": 60
			}
		}
	],
	"vars": {
		"BASE_DOMAIN": "localhost"
	},
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "LANI_DB",
					"database_name": "{{PRODUCTION_DATABASE_NAME}}",
					"database_id": "{{PRODUCTION_DATABASE_ID}}",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			"r2_buckets": [
				{
					"binding": "LANI_BUCKET_PUBLIC",
					"bucket_name": "{{PRODUCTION_BUCKET_PUBLIC_NAME}}"
				},
			],
			"kv_namespaces": [
				{
					"binding": "LANI_CACHE_KV",
					"id": "{{PRODUCTION_CACHE_KV_ID}}"
				}
			],
			"vars": {
				"BASE_DOMAIN": "laniakita.com"
			}
		}
	}
}