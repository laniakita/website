/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "laniakita-main",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"upload_source_maps": true,
	"ratelimits": [
		{
			"name": "RATE_LIMITER_GLOBAL",
			"namespace_id": "1001",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMITER_OG",
			"namespace_id": "1001",
			"simple": {
				"limit": 24,
				"period": 60
			}
		}
	],
	"vars": {
		"APP_URL": "https://laniakita.com"
	},
	"previews": {
		"vars": {
			"APP_URL": "https://preview.laniakita.com"
		},
		"ratelimits": [
			{
				"name": "RATE_LIMITER_GLOBAL",
				"namespace_id": "1001",
				"simple": {
					"limit": 300,
					"period": 60
				}
			},
			{
				"name": "RATE_LIMITER_OG",
				"namespace_id": "1001",
				"simple": {
					"limit": 24,
					"period": 60
				}
			}
		]
	},
	"env": {
		"local": {
			"vars": {
				"APP_URL": "http://localhost:3000"
			}
		}
	}
}